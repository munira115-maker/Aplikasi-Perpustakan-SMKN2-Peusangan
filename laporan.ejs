<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Laporan Perpustakaan - SMKN 2 Peusangan</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Times New Roman', Times, serif; }
        body { background: #fff; padding: 30px; color: #000; }
        
        .kop-surat { text-align: center; border-bottom: 3px double #000; padding-bottom: 8px; margin-bottom: 20px; }
        .kop-surat h3 { font-size: 16px; font-weight: bold; letter-spacing: 3px; text-transform: uppercase; }
        .kop-surat h4 { font-size: 15px; font-weight: bold; text-transform: uppercase; margin: 2px 0; }
        .kop-surat h2 { font-size: 18px; font-weight: bold; text-transform: uppercase; margin-bottom: 4px; }
        .kop-surat p { font-size: 11px; line-height: 1.3; font-style: normal; }

        .judul-laporan { text-align: center; margin-bottom: 25px; text-transform: uppercase; text-decoration: underline; font-size: 15px; }
        .stat-grid { display: flex; justify-content: space-between; margin-bottom: 20px; gap: 10px; }
        .stat-card { border: 1px solid #000; padding: 10px; text-align: center; flex: 1; }
        .stat-card h4 { font-size: 11px; margin-bottom: 5px; }
        .stat-card p { font-size: 16px; font-weight: bold; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 30px; font-size: 12px; }
        th, td { border: 1px solid #000; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; text-align: center; }
        .ttd-container { display: flex; justify-content: space-between; margin-top: 40px; page-break-inside: avoid; }
        .ttd-box { text-align: center; width: 40%; font-size: 13px; }
        .btn-print { background: #0d47a1; color: white; padding: 10px 20px; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; margin-bottom: 20px; }
        @media print {
            .btn-print { display: none; }
            body { padding: 0; }
        }
    </style>
</head>
<body>

    <button onclick="window.print()" class="btn-print">🖨️ Cetak / Simpan PDF</button>

    <div class="kop-surat">
        <h3>P E M E R I N T A H &nbsp; A C E H</h3>
        <h4>DINAS PENDIDIKAN</h4>
        <h2>SEKOLAH MENENGAH KEJURUAN NEGERI 2 PEUSANGAN</h2>
        <p>Jalan Pesantren Tanoh Mirah Cot Ijue Kec. Peusangan Kab. Bireuen Kode Pos 24261</p>
        <p>Website : smkn2peusangan.sch.id; Email : smkn2peusangan042013@gmail.com</p>
    </div>

    <h3 class="judul-laporan">Laporan Rekapitulasi Peminjaman Buku Perpustakaan</h3>

    <div class="stat-grid">
        <div class="stat-card">
            <h4>Total Judul Buku</h4>
            <p><%= stats.total_buku || 0 %></p>
        </div>
        <div class="stat-card">
            <h4>Total Eksemplar Stok</h4>
            <p><%= stats.total_stok || 0 %></p>
        </div>
        <div class="stat-card">
            <h4>Total Transaksi</h4>
            <p><%= stats.total_transaksi || 0 %></p>
        </div>
        <div class="stat-card">
            <h4>Sedang Dipinjam</h4>
            <p><%= stats.dipinjam || 0 %></p>
        </div>
        <div class="stat-card">
            <h4>Sudah Dikembalikan</h4>
            <p><%= stats.dikembalikan || 0 %></p>
        </div>
    </div>

    <h4 style="margin-bottom: 10px; font-size: 13px;">A. Detail Riwayat Transaksi Peminjaman</h4>
    <table>
        <thead>
            <tr>
                <th style="width: 5%;">No</th>
                <th>Nama Peminjam</th>
                <th>Judul Buku</th>
                <th>Tanggal Pinjam</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% if (history.length === 0) { %>
                <tr>
                    <td colspan="5" style="text-align: center;">Belum ada riwayat peminjaman.</td>
                </tr>
            <% } else { %>
                <% history.forEach((item, index) => { %>
                    <tr>
                        <td style="text-align: center;"><%= index + 1 %></td>
                        <td><%= item.nama %></td>
                        <td><%= item.judul %></td>
                        <td style="text-align: center;"><%= new Date(item.tanggal_pinjam).toLocaleDateString('id-ID') %></td>
                        <td style="text-align: center; text-transform: capitalize;"><%= item.status.replace('_', ' ') %></td>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>

    <div class="ttd-container">
        <div class="ttd-box">
            <p>Mengetahui,</p>
            <p><strong>Kepala SMKN 2 Peusangan</strong></p>
            <br><br><br><br>
            <p><u>( ________________________ )</u></p>
            <p>NIP.</p>
        </div>
        <div class="ttd-box">
            <p>Peusangan, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
            <p><strong>Pengelola Perpustakaan</strong></p>
            <br><br><br><br>
            <p><u>( <%= user.nama %> )</u></p>
            <p>NIP/NUPTK.</p>
        </div>
    </div>

</body>
</html>